* text=auto
# Keep generated skill mirrors stable across Windows and Unix checkouts.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.hdr binary
*.cmd text eol=crlf
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.spp filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
# Exact authored skin data used only by the Unity Oscar import verifier.
unity/SpaceDragon/Assets/SpaceDragon/Dogfight/Editor/*.bytes filter=lfs diff=lfs merge=lfs -text
unity/SpaceDragon/Assets/SpaceDragon/Dogfight/Imported/dragon-oscar-*-NOTICE.txt text eol=lf
# Vendored decoder payload hashes must survive Windows/Linux checkouts byte-for-byte.
public/assets/pod/decoder/* -text whitespace=cr-at-eol

# Babylon photographic lighting container; this is a binary runtime asset.
public/assets/drive/sky/*.env binary

# Runtime license bytes are registered in the asset manifest on every platform.
public/assets/drive/pedestrians/*.txt text eol=lf

# Unity text serialization emits spaces after empty YAML values; preserve those
# generated bytes while keeping checkouts consistent across platforms.
unity/**/*.asset text eol=lf whitespace=-blank-at-eol
unity/**/*.unity text eol=lf whitespace=-blank-at-eol
unity/**/*.meta text eol=lf whitespace=-blank-at-eol
unity/**/*.mat text eol=lf whitespace=-blank-at-eol
unity/**/*.anim text eol=lf whitespace=-blank-at-eol
unity/**/*.playable text eol=lf whitespace=-blank-at-eol
unity/**/*.prefab text eol=lf whitespace=-blank-at-eol
unity/**/*.cs text eol=lf
unity/**/*.asmdef text eol=lf
unity/**/*.jslib text eol=lf

# Detailed Unity export inventories verify the same source license bytes.
unity/SpaceDragon/Assets/SpaceDragon/TownDrive/Imported/**/*.txt text eol=lf
# Unity writes empty YAML properties with trailing spaces. Preserve its serialized bytes.
unity/SpaceDragon/Assets/SpaceDragon/TownDrive/**/*.meta whitespace=-blank-at-eol
unity/SpaceDragon/Assets/SpaceDragon/TownDrive/Generated/**/*.mat whitespace=-blank-at-eol
unity/SpaceDragon/Assets/SpaceDragon/TownDrive/Generated/*.asset whitespace=-blank-at-eol
unity/SpaceDragon/Assets/SpaceDragon/TownDrive/Generated/*.unity whitespace=-blank-at-eol
unity/SpaceDragon/Assets/WebGLTemplates.meta whitespace=-blank-at-eol
unity/SpaceDragon/Assets/WebGLTemplates/TownDrive.meta whitespace=-blank-at-eol
unity/SpaceDragon/Assets/WebGLTemplates/TownDrive/*.meta whitespace=-blank-at-eol
# Small synthesized preview sounds are regular Git binary blobs; other WAV masters use Git LFS.
assets/game/audio/starter/*.wav -filter -diff -merge -text

# Scene-linked Oscar derivatives retain their exact serialized payload bytes.
unity/SpaceDragon/Assets/SpaceDragon/Dogfight/Generated/OscarFullWeights/**/*.asset filter=lfs diff=lfs merge=lfs -text
unity/SpaceDragon/Assets/SpaceDragon/Dogfight/Generated/OscarBC7/**/*.asset filter=lfs diff=lfs merge=lfs -text
# Immutable Blender export receipt is hash-pinned with its original line endings.
unity/SpaceDragon/Assets/SpaceDragon/Dogfight/oscar-export-receipt-v001.json -text whitespace=cr-at-eol
