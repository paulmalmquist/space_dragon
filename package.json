{
  "name": "space-dragon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1 --open /space-dragon/",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:headed": "playwright test --headed",
    "check": "npm run test:unit && npm run build && npm test && npm run test:production && python tools/verify_family_references.py",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-doctor.ps1",
    "asset:inspect": "node tools/asset-inspect.mjs",
    "asset:tools": "gltf-transform",
    "browser:install": "playwright install chromium",
    "unity:dogfight:prepare": "node tools/unity/prepare-dogfight-assets.mjs",
    "unity:dogfight:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action setup",
    "unity:dogfight:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action test",
    "unity:dogfight:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action web",
    "unity:dogfight": "node tools/unity/serve-dogfight.mjs",
    "unity:dogfight:verify": "node tools/unity/verify-dogfight.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.0",
    "@babylonjs/loaders": "9.33.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@babylonjs/serializers": "9.33.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
