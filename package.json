{
  "name": "space-dragon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1 --open /space-dragon/",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:headed": "playwright test --headed",
    "check": "npm run test:unit && npm run build && npm test && npm run test:production && python tools/verify_family_references.py",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-doctor.ps1",
    "asset:inspect": "node tools/asset-inspect.mjs",
    "asset:tools": "gltf-transform",
    "browser:install": "playwright install chromium",
    "unity:traversal:export": "node --experimental-strip-types tools/unity/export-traversal.mjs",
    "unity:traversal:verify": "node --experimental-strip-types tools/unity/export-traversal.mjs --verify",
    "unity:traversal:parity": "dotnet run --project tools/unity/traversal-parity/harness/TraversalParity.csproj --configuration Release",
    "unity:playground:hero": "node tools/prepare-playground-hero.mjs",
    "unity:playground:export": "node --experimental-strip-types tools/unity/export-playground.mjs",
    "unity:playground:verify": "node tools/prepare-playground-hero.mjs --verify && node --experimental-strip-types tools/unity/export-playground.mjs --verify && node --experimental-strip-types tools/unity/export-arena.mjs --verify && node tools/unity/ensure-metas.mjs Playground Traversal --check",
    "unity:playground:compile": "dotnet build tools/unity/playground-compile/PlaygroundCompile.csproj --nologo",
    "unity:playground:coretest": "dotnet test tools/unity/traversal-parity/editmode/TraversalEditModeTests.csproj --nologo",
    "unity:playground:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action setup",
    "unity:playground:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action test",
    "unity:playground:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action windows",
    "unity:playground:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action web",
    "unity:playground:play": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action play",
    "unity:arena:export": "node --experimental-strip-types tools/unity/export-arena.mjs",
    "unity:arena:verify": "node --experimental-strip-types tools/unity/export-arena.mjs --verify",
    "unity:arena:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action arena-setup",
    "unity:arena:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action arena-windows",
    "unity:arena:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action arena-web",
    "unity:arena:play": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-playground.ps1 -Action arena-play",
    "unity:dogfight:prepare": "node tools/unity/prepare-dogfight-assets.mjs",
    "unity:dogfight:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action setup",
    "unity:dogfight:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action test",
    "unity:dogfight:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-dogfight.ps1 -Action web",
    "unity:dogfight": "node tools/unity/serve-dogfight.mjs",
    "unity:dogfight:verify": "node tools/unity/verify-dogfight.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.0",
    "@babylonjs/loaders": "9.33.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@babylonjs/serializers": "9.33.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
